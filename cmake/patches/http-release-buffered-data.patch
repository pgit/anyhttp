+    core::string_view
+    release_buffered_data() noexcept
+    {
+        if(state_ != state::complete)
+            return {};
+
+        // the octets past the message are at the end of cb0_,
+        // behind what is left of a plain body
+        auto const skip = is_plain() ? body_avail_ : 0;
+        if(cb0_.size() <= skip)
+            return {};
+
+        // make them contiguous: rotating the storage puts the
+        // second piece of the circular buffer behind the first
+        auto cbp = cb0_.data();
+        if(cbp[1].size() != 0)
+        {
+            auto* base = static_cast<char*>(
+                const_cast<void*>(cbp[1].data()));
+            auto* first = static_cast<char*>(
+                const_cast<void*>(cbp[0].data()));
+            auto const cap = cb0_.max_size();
+            auto const size = cb0_.size();
+            std::rotate(base, first, first + cbp[0].size());
+            cb0_ = { base, cap, size };
+            cbp = cb0_.data();
+        }
+
+        auto const* p = static_cast<char const*>(cbp[0].data());
+        core::string_view leftover(p + skip, cb0_.size() - skip);
+
+        // released: no longer part of what the parser holds, but
+        // the storage stays as it is until the next modifying call.
+        // What is left is the body, and that is all the buffer
+        // may claim: p is not the base of the storage.
+        cb0_ = { const_cast<char*>(p), skip, skip };
+        return leftover;
+    }
