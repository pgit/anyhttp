@PACKAGE_INIT@

#
# find_package(anyhttp) -- the target is anyhttp::anyhttp. Its options are fixed by how this copy was
# built, and whatever else goes into the process has to agree with them: one TLS library, one nghttp2
# and one standard library per process.
#
set(anyhttp_API "@ANYHTTP_API@")
set(anyhttp_TLS_LIBRARY "@TLS_LIBRARY@")
set(anyhttp_H2_LIBRARY "@H2_LIBRARY@")

include(CMakeFindDependencyMacro)

# Where the dependencies came from when this copy was built, in front of what the caller searches
# and only for as long as this file runs, like the choice of static Boost libraries.
set(_anyhttp_prefix_path "${CMAKE_PREFIX_PATH}")
set(_anyhttp_boost_static "${Boost_USE_STATIC_LIBS}")

if (@USE_LIBCXX@)
    list(PREPEND CMAKE_PREFIX_PATH "@LIBCXX_ROOT@")
    set(Boost_USE_STATIC_LIBS ON)
endif()

find_dependency(Threads)
find_dependency(Boost @ANYHTTP_BOOST_VERSION@ COMPONENTS @ANYHTTP_BOOST_COMPONENTS@)
find_dependency(spdlog)

if (anyhttp_TLS_LIBRARY STREQUAL "AWS-LC")
    list(PREPEND CMAKE_PREFIX_PATH "@BORINGSSL_ROOT@")
    find_dependency(ssl CONFIG)
else()
    find_dependency(OpenSSL 3.5)
endif()

# The library is static, so the C libraries behind it are still to be linked by the user of it.
find_dependency(PkgConfig)
pkg_check_modules(NGHTTP2 REQUIRED IMPORTED_TARGET @ANYHTTP_H2_MODULE@)
pkg_check_modules(NGTCP2 REQUIRED IMPORTED_TARGET libngtcp2)
pkg_check_modules(NGHTTP3 REQUIRED IMPORTED_TARGET libnghttp3)
pkg_check_modules(NGTCP2_CRYPTO REQUIRED IMPORTED_TARGET @NGTCP2_CRYPTO_MODULE@)

set(CMAKE_PREFIX_PATH "${_anyhttp_prefix_path}")
set(Boost_USE_STATIC_LIBS "${_anyhttp_boost_static}")
unset(_anyhttp_prefix_path)
unset(_anyhttp_boost_static)

include("${CMAKE_CURRENT_LIST_DIR}/anyhttp-targets.cmake")
check_required_components(anyhttp)
